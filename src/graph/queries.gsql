// queries.gsql
// Installed queries for the HHgoa4 fraud-investigation agent. Verified to install on
// TigerGraph Savanna 4.2.5.
//
// Notes from the live instance:
// - SYNTAX v2 requires a direction on every edge in a pattern: -(MADE>)- not -(MADE)-.
// - PRIMARY_IDs are not attributes here, so region/device/card ids are collected into
//   SetAccum<VERTEX> accumulators; PRINT renders those as primary-id strings, which
//   src/agent/deps.py flattens into detector rows.
// - The agent's own case vertex is InvestigationCase ("Case" is a reserved keyword).

// ---------------------------------------------------------------------------
// 1. card_window -- every transaction on a card within +/- hours of an anchor time,
// with billing region and device profile attached. Input to card-testing (R5),
// cnp_burst, new_device and out_of_region detectors.
// ---------------------------------------------------------------------------
CREATE OR REPLACE QUERY card_window(VERTEX<Card> card_id, DATETIME anchor, INT hours) SYNTAX v2 {
  SetAccum<VERTEX> @region, @device;
  SetAccum<STRING> @country;
  seed = {card_id};
  txns = SELECT t FROM seed:c -(MADE>)- Transaction:t
         WHERE abs(datetime_diff(t.ts, anchor)) <= hours * 3600;
  tmp = SELECT t FROM txns:t -(BILLED_IN>)- BillingRegion:b
        ACCUM t.@region += b, t.@country += b.country_code;
  tmp = SELECT t FROM txns:t -(FROM_DEVICE>)- DeviceProfile:d
        ACCUM t.@device += d;
  PRINT txns;
}

// ---------------------------------------------------------------------------
// 2. device_neighbors -- shared-device ring query (R6, shared_origin detector).
// Every transaction on this device profile near the anchor, with the card and
// customer behind it, plus closed cases already opened on any of those cards.
// ---------------------------------------------------------------------------
CREATE OR REPLACE QUERY device_neighbors(VERTEX<DeviceProfile> device_id, DATETIME anchor, INT hours) SYNTAX v2 {
  SetAccum<VERTEX> @card, @cust;
  dev  = {device_id};
  txns = SELECT t FROM dev:d -(DEVICE_OF>)- Transaction:t
         WHERE abs(datetime_diff(t.ts, anchor)) <= hours * 3600;
  cards = SELECT c FROM txns:t -(MADE_BY>)- Card:c
          ACCUM t.@card += c;
  tmp = SELECT cu FROM cards:c -(OWNED_BY>)- Customer:cu
        ACCUM c.@cust += cu;
  tmp = SELECT t FROM txns:t -(MADE_BY>)- Card:c
        ACCUM t.@cust += c.@cust;
  cases = SELECT cc FROM cards:c -(HAS_CASE>)- ClosedCase:cc;
  PRINT txns[txns.ts, txns.amount, txns.channel, txns.id_15, txns.id_23, txns.@card, txns.@cust];
  PRINT cases[cases.outcome, cases.pattern, cases.card_id];
}

// ---------------------------------------------------------------------------
// 3. customer_baseline -- a customer's full transaction history across all their cards,
// with card and region attached. The client splits it at the case's opened_at so the
// baseline never includes post-trigger activity; it also feeds the multi-card
// account_takeover detector.
// ---------------------------------------------------------------------------
CREATE OR REPLACE QUERY customer_baseline(VERTEX<Customer> customer_id) SYNTAX v2 {
  SetAccum<VERTEX> @card, @region, @device;
  cust  = {customer_id};
  cards = SELECT c FROM cust:cu -(OWNS>)- Card:c;
  txns  = SELECT t FROM cards:c -(MADE>)- Transaction:t
          ACCUM t.@card += c;
  tmp = SELECT t FROM txns:t -(BILLED_IN>)- BillingRegion:b
        ACCUM t.@region += b;
  tmp = SELECT t FROM txns:t -(FROM_DEVICE>)- DeviceProfile:d
        ACCUM t.@device += d;
  PRINT txns[txns.ts, txns.amount, txns.channel, txns.product_cd, txns.risk_score,
             txns.id_15, txns.id_23, txns.M4, txns.M6, txns.@card, txns.@region, txns.@device];
}

// ---------------------------------------------------------------------------
// 4. prior_cases_for_entities -- structural case memory. Closed cases that touch any of
// the given cards (directly or as a connected card) or any transaction on the given
// device profiles; @via lists the entities that link each case. Devices are browser
// fingerprints (median 1 customer, but up to 842), so only rare devices (<= 100
// transactions) count as a structural link -- a common "Windows 10 / Chrome" profile
// would otherwise tie a legitimate customer to dozens of unrelated fraud cases.
// ---------------------------------------------------------------------------
CREATE OR REPLACE QUERY prior_cases_for_entities(SET<VERTEX<Card>> cards,
                                                 SET<VERTEX<DeviceProfile>> devs) SYNTAX v2 {
  SetAccum<VERTEX> @via;
  cs = {cards};
  ds = {devs};
  ds = SELECT d FROM ds:d WHERE d.outdegree("DEVICE_OF") <= 100;
  c1 = SELECT cc FROM cs:c -(HAS_CASE>)- ClosedCase:cc ACCUM cc.@via += c;
  c2 = SELECT cc FROM cs:c -(CONNECTED_FROM>)- ClosedCase:cc ACCUM cc.@via += c;
  c3 = SELECT cc FROM ds:d -(DEVICE_OF>)- Transaction:t -(INVOLVED_IN>)- ClosedCase:cc
       ACCUM cc.@via += d;
  result = c1 UNION c2 UNION c3;
  PRINT result[result.outcome, result.pattern, result.exposure_usd, result.opened_at,
               result.card_id, result.analyst_notes, result.@via];
}

// ---------------------------------------------------------------------------
// 5. similar_prior_cases -- semantic case memory over ClosedCase.notesEmb (HNSW), run
// once per outcome pool so the 5:1 fraud:cleared base rate never crowds out the
// exonerating precedent (src/rag/retrieve.py two-pool rule).
// ---------------------------------------------------------------------------
CREATE OR REPLACE QUERY similar_prior_cases(LIST<FLOAT> qvec, STRING pool, INT k) SYNTAX v3 {
  MapAccum<VERTEX, FLOAT> @@dist;
  cand = SELECT c FROM (c:ClosedCase) WHERE c.outcome == pool;
  v = vectorSearch({ClosedCase.notesEmb}, qvec, k, {candidate_set: cand, distance_map: @@dist});
  PRINT v[v.outcome, v.pattern, v.exposure_usd, v.opened_at, v.card_id, v.analyst_notes];
  PRINT @@dist AS dist;
}

// ---------------------------------------------------------------------------
// 6. write_case_to_graph -- the agent's own case record, linked to the transactions,
// card and connected cards it covers, so later investigations can traverse it.
// ---------------------------------------------------------------------------
CREATE OR REPLACE QUERY write_case_to_graph(
    STRING case_id, STRING customer_id, STRING card_id, DATETIME opened_at, DATETIME closed_at,
    STRING status, STRING verdict, STRING outcome, STRING pattern, STRING first_txn,
    SET<STRING> txn_ids, DOUBLE exposure, SET<STRING> connected_cards,
    STRING actions_taken, BOOL report_filed, STRING analyst_notes) SYNTAX v2 {
  INSERT INTO InvestigationCase VALUES (case_id, customer_id, card_id, status, verdict, outcome,
      pattern, first_txn, txn_ids.size(), exposure, actions_taken, report_filed,
      analyst_notes, opened_at, closed_at);
  INSERT INTO CASE_ON_CARD VALUES (case_id, card_id);
  FOREACH t IN txn_ids DO
    INSERT INTO CASE_INVOLVES VALUES (case_id, t);
  END;
  FOREACH c IN connected_cards DO
    INSERT INTO CASE_CONNECTED_TO VALUES (case_id, c);
  END;
  PRINT case_id;
}
