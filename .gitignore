# Dataset — large, provided by organizers, never committed.
# The directory and its instructions are tracked; the data itself is not.
*.csv
*.zip
HHGOA_IEEE_Dataset/
data/*
!data/.gitkeep
!data/README.md

# Test fixtures are ours (derived from the brief's own tables), not organizer data.
!tests/fixtures/**/*.csv

# Derived data
*.parquet
*.feather
artifacts/
embeddings/

# Screenshots / scratch
*.jpeg
*.jpg
*.png
!docs/**/*.png
!docs/**/*.svg
scratch/

# Exported chat logs. These carry the credentials the team pasted to each other,
# so they must never be committed — the repo is public.
chat*.txt
chat*.md
*whatsapp*
*WhatsApp*

# Secrets
.env
.env.*
!.env.example
*.pem
secrets.json

