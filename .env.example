# TigerGraph Savanna — copy to .env and fill in
# Workspace URL from the Savanna connection panel. NOT savanna.tgcloud.io.
TG_HOST=https://your-workspace.i.tgcloud.io
TG_GRAPHNAME=FraudGraph
TG_TGCLOUD=true
TG_API_TOKEN=

# Community Edition alternative (local Docker)
# TG_HOST=http://localhost
# TG_GRAPHNAME=FraudGraph
# TG_USERNAME=tigergraph
# TG_PASSWORD=tigergraph
# TG_RESTPP_PORT=9000
# TG_GS_PORT=14240
# TG_TGCLOUD=false

# LLM — used for evidence narration and SAR prose, never for picking actions
# or emitting probabilities (those are deterministic, see config/)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Embeddings. Falls back to local sentence-transformers if no key is set;
# keep EMBED_DIM in sync with the vector attribute in src/graph/schema.gsql.
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1536
