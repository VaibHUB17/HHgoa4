# =============================================================================
# TigerGraph Cloud (Savanna) Connection Settings
# =============================================================================
# Workspace URL from the Savanna connection panel (e.g. https://fraud-detection-xxxx.i.tgcloud.io).
# NOT savanna.tgcloud.io. No trailing slash.
TG_HOST=https://your-workspace.i.tgcloud.io
TG_GRAPH=FraudInvestigation
TG_USERNAME=tigergraph
TG_PASSWORD=your_password
TG_SECRET=your_gsql_secret
TG_API_TOKEN=
TG_TGCLOUD=true

# =============================================================================
# LLM -- prose only (SAR narrative, case summary). Never picks actions or
# emits probabilities; those stay deterministic (src/policy/, config/).
# Groq: OpenAI-API-compatible, so the `openai` package already in
# pyproject.toml works against it via base_url override -- no new dependency.
# =============================================================================
GROQ_API_KEY=your_groq_api_key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.8-27b

# Optional fallback LLM providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# =============================================================================
# Embeddings -- case memory (ClosedCase.notesEmb) + policy/reg doc grounding
# (PolicyChunk.textEmb). gemini-embedding-001, NOT -002 (elementwise vs
# aggregated -- see project decision log / conversation with Bhavya).
# output_dimensionality=1536 matches schema.gsql's DIMENSION=1536 exactly.
# =============================================================================
GEMINI_API_KEY=your_gemini_api_key
EMBED_PROVIDER=gemini
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=1536
