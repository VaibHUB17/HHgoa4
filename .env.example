# =============================================================================
# TigerGraph Cloud (Savanna) Connection Settings
# =============================================================================
# Workspace URL from the Savanna connection panel (e.g. https://fraud-detection-xxxx.i.tgcloud.io). NOT savanna.tgcloud.io. No trailing slash.
TG_HOST=https://your-workspace.i.tgcloud.io
TG_GRAPH=FraudInvestigation
TG_USERNAME=tigergraph
TG_PASSWORD=your_password
TG_SECRET=your_gsql_secret
TG_API_TOKEN=
TG_TGCLOUD=true

# LLM — used for evidence narration and SAR prose, never for picking actions
# or emitting probabilities (those are deterministic, see config/)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Embeddings. Falls back to local sentence-transformers if no key is set;
# keep EMBED_DIM in sync with the vector attribute in src/graph/schema.gsql.
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1536
